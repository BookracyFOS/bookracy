ien"],"y":2004,"s":"American History","w":[["bancroft-prize","Bancroft Prize",2005,"winner"],["oah-book-prizes","Merle Curti Award",2005,"co_winner"],["pulitzer-prize","History",2005,"finalist"]],"i":313},{"t":"Alexander Hamilton","a":["Ron Chernow"],"y":2004,"s":"Biography","w":[["george-washington-book-prize","Founding Era",2005,"winner"],["los-angeles-times-book-prize","Biography",2004,"finalist"],["national-book-critics-circle-awards","Biography",2004,"finalist"]],"i":314},{"t":"Jonathan Edwards: A Life","a":["George M. Marsden"],"y":2004,"s":"Biography","w":[["bancroft-prize","Bancroft Prize",2004,"winner"],["oah-book-prizes","Merle Curti Award",2004,"co_winner"],["national-book-critics-circle-awards","Biography",2003,"finalist"]],"i":315},{"t":"The Black Hearts of Men: Radical Abolitionists and the Transformation of Race","a":["John Stauffer"],"y":2004,"s":"Race & Ethnicity","w":[["oah-book-prizes","Civil War and Reconstruction Book Award",2003,"winner"],["frederick-douglass-book-prize","Slavery, Resistance, and Abolition",2002,"co_winner"],["lincoln-prize","Civil War Era",2003,"finalist"]],"i":316},{"t":"Random Family: Love, Drugs, Trouble, and Coming of Age in the Bronx","a":["Adrian Nicole LeBlanc"],"y":2003,"s":"Society & Culture","w":[["ridenhour-book-prize","Book Prize",2005,"winner"],["anisfield-wolf-book-awards","Nonfiction",2004,"co_winner"],["national-book-critics-circle-awards","Nonfiction",2003,"finalist"]],"i":317},{"t":"River of Shadows: Eadweard Muybridge and the Technological Wild West","a":["Rebecca Solnit"],"y":2003,"s":"Technology","w":[["mark-lynton-history-prize","Mark Lynton History Prize",2004,"winner"],["national-book-critics-circle-awards","Criticism",2003,"winner"],["los-angeles-times-book-prize","Biography",2003,"finalist"]],"i":318},{"t":"The Fiery Trial: Abraham Lincoln and American Slavery","a":["Eric Foner"],"y":2002,"s":"American History","w":[["bancroft-prize","Bancroft Prize",2011,"winner"],["lincoln-prize","Civil War Era",201