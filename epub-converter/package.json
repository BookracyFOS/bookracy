{
  "name": "bookracy-convertor",
  "version": "1.3.0",
  "description": "A tool to convert EPUB files to PDF using jsPDF",
  "main": "./dist/epub-converter.umd.js",
  "module": "./dist/epub-converter.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/epub-converter.umd.js",
      "import": "./dist/epub-converter.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "css-tree": "^3.1.0",
    "html-to-text": "^9.0.5",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/css-tree": "^2.3.10",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^5.4.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "sideEffects": [
    "src/polyfills/node-globals.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookracy/epub-convertor.git"
  },
  "keywords": [
    "epub",
    "pdf",
    "convert",
    "jsPDF",
    "EPUB",
    "HTML",
    "JavaScript"
  ],
  "author": "rdwxth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bookracy/epub-converter/issues"
  },
  "homepage": "https://github.com/bookracy/epub-converter#readme"
}
